  "global_rules": {
    "character_hygiene": true,
    "fullwidth_halfwidth_normalization": true,
    "zero_width_char_removal": true,
    "smart_quote_conversion": true,
    "min_title_length": 5,
    "max_title_length": 64,
    "cover_image_required": true,
    "cover_image_max_size_kb": 64,
    "cover_image_dimensions": "2560x1440",
    "article_min_length": 300,
    "article_max_length": 50000
  },
  "content_quality_checks": {
    "typo_check": {
      "enabled": true,
      "level": "basic",
      "description": "基础错别字检查（常见同音字、形近字）"
    },
    "readability_check": {
      "enabled": true,
      "level": "basic",
      "description": "基础语句通顺检查（过长句子、重复用词）"
    },
    "logic_check": {
      "enabled": true,
      "level": "basic",
      "description": "基础逻辑检查（矛盾陈述、数据一致性）"
    },
    "reference_check": {
      "enabled": true,
      "level": "flag_suspicious",
      "description": "引用内容标注可疑项（无法验证的数据、事件）"
    }
  }
