{
  "meta": {
    "name": "自媒体专项检测",
    "description": "公众号/自媒体场景：在通用规则基础上，额外检测书面语过重、段落过长、转折堆叠、总结句模板、小红书模板、标题党、营销CTA、口播腔",
    "version": "2.0.0"
  },
  "rules": [
    {
      "id": "S01",
      "name": "书面语过重",
      "category": "语体不匹配",
      "severity": "medium",
      "patterns": [
        "笔者认为",
        "笔者注意到",
        "笔者发现",
        "经笔者",
        "由笔者",
        "本文将",
        "本文旨在",
        "本文探讨",
        "如下所述",
        "如上所述",
        "前文所述",
        "后文将",
        "鉴于此",
        "有鉴于此",
        "故而",
        "然则",
        "诚然",
        "固然",
        "毋庸讳言",
        "毋庸置疑",
        "据此",
        "由此",
        "据此可见",
        "进而",
        "倘若",
        "倘若如此",
        "加之",
        "鉴于上述"
      ],
      "suggestion": "自媒体不需要书面语腔。'笔者认为'改'我觉得'，'本文将'直接删掉开头说事",
      "examples": [
        {
          "before": "笔者认为，AI工具的普及将深刻改变职场生态",
          "after": "我觉得，会拆任务的打工人，今年能省出一半加班时间"
        },
        {
          "before": "本文旨在探讨人工智能在办公场景中的应用",
          "after": "这篇聊聊AI怎么帮我把报表从3小时压到10分钟"
        }
      ]
    },
    {
      "id": "S02",
      "name": "段落过长",
      "category": "排版",
      "severity": "low",
      "patterns": [],
      "custom_check": "long_paragraph",
      "threshold": {
        "char_count": 200
      },
      "suggestion": "段落超200字=手机阅读体验差。建议在观点切换处断段",
      "examples": [
        {
          "before": "（一整段400字没换行）",
          "after": "按'现象/原因/解法'拆成3段，每段一个核心句"
        }
      ]
    },
    {
      "id": "S03",
      "name": "万能转折堆叠",
      "category": "AI句式",
      "severity": "medium",
      "patterns": [
        "然而.{0,20}但是",
        "虽然.{0,30}但是.{0,30}不过",
        "不过.{0,20}然而",
        "但是.{0,30}不过.{0,30}然而",
        "然而.{0,20}不过",
        "可是.{0,20}但是",
        "虽说.{0,30}但是.{0,30}可是"
      ],
      "suggestion": "一段话里多个转折词堆叠=AI在'辩证'。保留一个转折，其余删掉",
      "examples": [
        {
          "before": "虽然AI很强大，但是也有局限，不过换个角度看，其实也还好",
          "after": "AI很强大，但别指望它替你背锅——它只会照着你的指令干活"
        }
      ]
    },
    {
      "id": "S04",
      "name": "总结句模板",
      "category": "结构套话",
      "severity": "medium",
      "patterns": [
        "总而言之",
        "总的来说",
        "综上所述",
        "归根结底",
        "说到底",
        "归根到底",
        "一言以蔽之",
        "简而言之",
        "总的来说呢",
        "所以呢",
        "最后想说",
        "结尾想说的是"
      ],
      "suggestion": "结尾总结句=AI收尾模板。直接用最后一句话收尾，不需要总结词",
      "examples": [
        {
          "before": "综上所述，AI味检测工具是内容创作者不可或缺的利器",
          "after": "你负责写内容，它负责提醒你哪句像AI写的——就这"
        }
      ]
    },
    {
      "id": "S05",
      "name": "小红书信息块模板",
      "category": "排版模板",
      "severity": "medium",
      "patterns": [
        "✅.{0,20}(必|建议|记得|记得要|一定要)",
        "📍.{0,20}(地址|位置|坐标|门店)",
        "⏰.{0,20}(时间|营业|几点|开放)",
        "🌟.{0,20}(推荐|必看|亮点|加分)",
        "💡.{0,20}(小贴士|提示|技巧|建议)",
        "💰.{0,20}(价格|费用|人均|花销)",
        "📌.{0,20}(笔记|收藏|重点)",
        "❗.{0,20}(注意|警告|避雷|千万别)",
        "⚠️.{0,20}(注意|警告|避雷)"
      ],
      "suggestion": "emoji+关键词开头的信息块=小红书AI模板。全文超过2块就是批量生产的痕迹，改自然段落",
      "examples": [
        {
          "before": "✅ 必看：这款工具免费\n📍 下载：官网直接下\n⏰ 时间：10分钟搞定",
          "after": "工具免费，官网直接下，我第一次用10分钟就搭好了"
        }
      ]
    },
    {
      "id": "S06",
      "name": "标题党句式",
      "category": "结构套话",
      "severity": "medium",
      "patterns": [
        "震惊",
        "惊呆",
        "没想到",
        "万万没想到",
        "必看",
        "建议收藏",
        "码住",
        "干货满满",
        "干货十足",
        "纯干货",
        "保姆级",
        "超全",
        "最强",
        "最全",
        "天花板",
        "看完你就",
        "学会这.{1,8}招",
        "只需.{1,8}分钟",
        "一文看懂",
        "一篇搞定"
      ],
      "suggestion": "标题党词=流量焦虑的AI味。正文里出现'震惊/必看/建议收藏'=心虚。直接给具体价值",
      "examples": [
        {
          "before": "震惊！这份保姆级教程，干货满满，建议收藏！",
          "after": "照着这份清单，10分钟搭好你的第一个文档质检工具"
        }
      ]
    },
    {
      "id": "S07",
      "name": "营销CTA堆叠",
      "category": "结构套话",
      "severity": "low",
      "patterns": [
        "私信我",
        "找我领取",
        "回复关键词",
        "后台回复",
        "扫码添加",
        "加我微信",
        "点击链接",
        "点击购买",
        "点击下方",
        "现在下单",
        "限时优惠",
        "限时抢购",
        "仅限.{1,8}天",
        "错过再等"
      ],
      "suggestion": "营销CTA本身没问题，但全文超过3个=广告味。留1个主CTA，其余删掉",
      "examples": [
        {
          "before": "想领取资料包的请私信我，回复关键词领取，也可以扫码加我微信，现在下单还有限时优惠",
          "after": "资料包在公众号后台回复「工具」就能领"
        }
      ]
    },
    {
      "id": "S08",
      "name": "口播腔残留",
      "category": "语体不匹配",
      "severity": "low",
      "patterns": [
        "大家好",
        "哈喽大家好",
        "欢迎收看",
        "欢迎来到",
        "本期视频",
        "今天这期",
        "我们这期",
        "好了话不多说",
        "废话不多说",
        "咱们直接开始",
        "我们直接进入正题",
        "感谢观看",
        "我们下期再见",
        "下期见",
        "拜拜"
      ],
      "suggestion": "口播腔残留=视频稿直接转文字的痕迹。删掉'大家好/本期视频/下期再见'，文字稿不需要",
      "examples": [
        {
          "before": "哈喽大家好，欢迎来到本期视频，今天这期教大家用AI做标书，好了话不多说，我们直接开始",
          "after": "用AI做标书，最难的不是写，是排版。这篇讲怎么跑通全流程"
        }
      ]
    },
    {
      "id": "S09",
      "name": "AI客套感谢",
      "category": "结构套话",
      "severity": "low",
      "patterns": [
        "感谢大家的阅读",
        "感谢阅读",
        "谢谢阅读",
        "感谢观看",
        "谢谢大家",
        "感谢大家",
        "感谢你的(阅读|观看|关注|支持)",
        "再次感谢",
        "由衷感谢",
        "万分感谢",
        "感谢支持"
      ],
      "suggestion": "空泛致谢=AI礼貌残留。真要谢，谢具体的人或事：'感谢上周打赏的读者'",
      "examples": [
        {
          "before": "感谢大家的阅读，我们下期再见",
          "after": "上周有人私信问检测工具怎么装，这篇就是给这类问题写的"
        }
      ]
    },
    {
      "id": "S10",
      "name": "划线金句模板",
      "category": "AI句式",
      "severity": "low",
      "patterns": [
        "记住，.{1,30}",
        "请记住，.{1,30}",
        "切记，.{1,30}",
        "别忘了，.{1,30}",
        "记住一句话：.{1,30}",
        "你只需要记住：.{1,30}",
        "核心就一句：.{1,30}",
        "说白了就是：.{1,30}"
      ],
      "suggestion": "'记住/别忘了+金句'=AI爱用划线句收尾。全文最多1处，多了=表演",
      "examples": [
        {
          "before": "请记住，工具永远是工具，人才是核心",
          "after": "工具不会替你思考，但它能替你熬夜"
        }
      ]
    }
  ]
}
