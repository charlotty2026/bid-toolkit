{
  "meta": {
    "name": "通用AI味检测",
    "description": "所有场景共用的AI味规则：起承转合套话、AI自我暴露、万能助词、对仗招牌句式、清单符号、路标词、假互动、过度拔高、翻译腔、表演感、二元框架、AI式谦卑",
    "version": "2.0.0"
  },
  "rules": [
    {
      "id": "C01",
      "name": "起承转合套话",
      "category": "结构套话",
      "severity": "high",
      "patterns": [
        "值得注意的是",
        "不可忽视的是",
        "不可否认的是",
        "不容忽视的是",
        "不言而喻",
        "毋庸置疑",
        "众所周知",
        "综上所述",
        "总而言之",
        "由此可见",
        "由此可见一斑",
        "值得一提的是",
        "需要指出的是",
        "需要强调的是",
        "说白了就是",
        "归根结底",
        "归根到底",
        "一言以蔽之",
        "简而言之",
        "首先.{0,20}其次.{0,20}最后",
        "一方面.{0,30}另一方面"
      ],
      "suggestion": "删除套话，直接说结论。读者不需要被引导",
      "examples": [
        {
          "before": "值得注意的是，AI味雷达的检测精度极高",
          "after": "AI味雷达检测精度极高，实测317字查出25条AI味"
        },
        {
          "before": "综上所述，本方案可以有效提升服务质量",
          "after": "本方案把响应时间从4小时压到40分钟"
        }
      ]
    },
    {
      "id": "C02",
      "name": "AI自我暴露",
      "category": "身份泄露",
      "severity": "fatal",
      "patterns": [
        "作为AI",
        "作为人工智能",
        "作为语言模型",
        "我是AI",
        "我是一个AI",
        "作为一个AI",
        "作为一个人工智能",
        "我建议您",
        "我无法",
        "我不能",
        "我理解您的",
        "根据我的理解",
        "基于以上分析",
        "通过以上分析",
        "经过分析",
        "经过深入分析",
        "我会尽力",
        "我将尽力",
        "让我为您",
        "让我帮你",
        "如果您有任何问题"
      ],
      "suggestion": "删除AI身份暗示，改为事实陈述",
      "examples": [
        {
          "before": "作为AI，我建议您先检查依赖配置",
          "after": "先跑 pip list 看依赖装没装"
        },
        {
          "before": "基于以上分析，我们可以得出以下结论",
          "after": "结论：模板句式的AI味命中率最高"
        }
      ]
    },
    {
      "id": "C03",
      "name": "万能助词",
      "category": "空洞词汇",
      "severity": "medium",
      "patterns": [
        "赋能",
        "闭环",
        "抓手",
        "底层逻辑",
        "顶层设计",
        "生态系统",
        "生态闭环",
        "降维打击",
        "赛道",
        "打法",
        "心智",
        "颗粒度",
        "对齐",
        "拉齐",
        "沉淀",
        "复用",
        "链路",
        "触达",
        "心智模型",
        "范式",
        "范式转移",
        "护城河",
        "第二曲线",
        "飞轮",
        "杠杆",
        "天花板",
        "破圈",
        "矩阵",
        "组合拳",
        "一盘棋",
        "同频",
        "共振"
      ],
      "suggestion": "替换为具体动作或删除。用'帮助'替代'赋能'，用'流程'替代'闭环'，用'反复用'替代'复用'",
      "examples": [
        {
          "before": "通过赋能开发者，打造AI生态闭环",
          "after": "让开发者少写300行配置代码"
        },
        {
          "before": "我们要抓住这个赛道的底层逻辑",
          "after": "用户要的是快，不是功能多"
        }
      ]
    },
    {
      "id": "C04",
      "name": "对仗AI招牌句式",
      "category": "AI句式",
      "severity": "high",
      "patterns": [
        "不仅.{1,15}更",
        "不仅.{1,15}而且",
        "既.{1,10}又.{1,10}",
        "不是.{1,15}而是",
        "与其.{1,15}不如",
        "从.{1,10}到.{1,10}的",
        "从.{1,10}走向.{1,10}",
        "从.{1,10}迈向.{1,10}",
        "让.{1,15}让.{1,15}让",
        "让.{1,15}使.{1,15}令",
        "为.{1,15}提供.{1,15}支撑",
        "是.{1,10}更是.{1,10}",
        "既是.{1,10}也是.{1,10}",
        "无论.{1,15}还是.{1,15}都"
      ],
      "suggestion": "对仗句式是AI最高频模板。拆成两个独立短句，去掉'不仅/既/不是...而是'的框架",
      "examples": [
        {
          "before": "这不仅提升了效率，更保障了质量",
          "after": "效率提升40%，废标率归零"
        },
        {
          "before": "既保证了专业性，又兼顾了灵活性",
          "after": "模板保留专业术语，参数可以随时调"
        }
      ]
    },
    {
      "id": "C05",
      "name": "清单符号跨段重复",
      "category": "排版模板",
      "severity": "medium",
      "patterns": [
        "①②③④⑤",
        "（1）（2）（3）",
        "第一.{0,5}第二.{0,5}第三",
        "首先.{0,5}其次.{0,5}再次"
      ],
      "suggestion": "同一篇文章内清单符号重复使用超2次=平台一眼模板。打散为自然段落或换编号方式",
      "examples": [
        {
          "before": "第一，优化流程。第二，降低成本。第三，提升效率。（另一段又：第一，……第二，……第三，……）",
          "after": "把第一段合并成自然段落，第二段改用小标题"
        }
      ]
    },
    {
      "id": "C06",
      "name": "路标词行内堆叠",
      "category": "AI句式",
      "severity": "high",
      "patterns": [
        "首先.{0,3}其次.{0,3}再次.{0,3}最后",
        "第一.{0,3}第二.{0,3}第三.{0,3}第四",
        "第一步.{0,3}第二步.{0,3}第三步",
        "一来.{0,3}二来.{0,3}三来",
        "其一.{0,3}其二.{0,3}其三"
      ],
      "suggestion": "一句话内连续4个路标词=AI答题腔。拆成独立段落，去掉编号直接说",
      "examples": [
        {
          "before": "首先，我们需要梳理需求；其次，搭建框架；再次，填充内容；最后，逐项质检",
          "after": "梳理需求、搭框架、填内容、逐项质检，四步走完"
        }
      ]
    },
    {
      "id": "C07",
      "name": "假互动结尾",
      "category": "结构套话",
      "severity": "medium",
      "patterns": [
        "欢迎在评论区",
        "欢迎留言",
        "欢迎讨论",
        "欢迎交流",
        "你(们)?怎么看",
        "你怎么看呢",
        "大家觉得呢",
        "快来评论区",
        "评论区告诉我",
        "留言告诉我",
        "让我知道你的想法",
        "你有什么想法",
        "你们觉得",
        "欢迎大家",
        "记得点赞",
        "记得关注",
        "点个赞",
        "一键三连",
        "关注我",
        "想了解更多"
      ],
      "suggestion": "结尾抛给读者的假互动问题=AI收尾模板。真实互动靠内容本身，不是靠问句",
      "examples": [
        {
          "before": "你觉得AI会取代人类吗？欢迎在评论区留言讨论",
          "after": "AI取代的不是人，是不用AI的人——这个结论你信不信，跑一次数据就知道"
        }
      ]
    },
    {
      "id": "C08",
      "name": "过度拔高",
      "category": "空洞词汇",
      "severity": "medium",
      "patterns": [
        "划时代",
        "颠覆性",
        "革命性",
        "里程碑",
        "前所未有的",
        "史无前例",
        "开创性",
        "引领未来",
        "重塑格局",
        "改变世界",
        "重新定义",
        "开启新篇章",
        "翻开新的一页",
        "质的飞跃",
        "巨大飞跃"
      ],
      "suggestion": "过度拔高=AI凑气势。删掉形容词，直接写具体数字和效果",
      "examples": [
        {
          "before": "这是一次颠覆性的技术革命，将重新定义行业格局",
          "after": "生成时间从3小时压到40秒，这是目前团队测过的最快方案"
        }
      ]
    },
    {
      "id": "C09",
      "name": "翻译腔",
      "category": "语体不匹配",
      "severity": "medium",
      "patterns": [
        "作为一名",
        "作为一个",
        "在某种程度上",
        "从某种程度上说",
        "一般来说",
        "事实上",
        "实际上而言",
        "显而易见的是",
        "值得注意的是",
        "不得不承认",
        "不可否认",
        "让我们来看",
        "让我们考虑",
        "在当今(这个)?(时代|社会)",
        "随着.{1,15}的(发展|到来|普及|推进)",
        "在这个.{1,10}的(时代|世界)",
        "我们生活在一个",
        "数字时代",
        "信息化浪潮",
        "全球化背景下"
      ],
      "suggestion": "翻译腔=英文句式直译。'作为一名工程师'改'我干这行'，'在当今时代'直接删掉",
      "examples": [
        {
          "before": "作为一名内容创作者，在当今数字时代，我们面临着前所未有的机遇",
          "after": "干内容这行的人，2026年最不缺的就是机会"
        },
        {
          "before": "随着人工智能技术的不断发展，越来越多的行业开始拥抱变革",
          "after": "AI写的东西越来越像人，审稿的压力就到了人这边"
        }
      ]
    },
    {
      "id": "C10",
      "name": "表演感语气",
      "category": "语体不匹配",
      "severity": "low",
      "patterns": [
        "哇塞",
        "绝绝子",
        "yyds",
        "YYDS",
        "YYDS！",
        "谁懂啊",
        "谁懂",
        "家人们",
        "姐妹们",
        "救命",
        "真的绝了",
        "简直了",
        "太香了",
        "狠狠",
        "妥妥的",
        "直接封神",
        "封神了",
        "天花板级别",
        "宝藏",
        "神器",
        "闭眼入",
        "无脑冲",
        "冲就完了"
      ],
      "suggestion": "表演感语气=AI模仿网络热词的痕迹。正式场景删掉，自媒体场景也最多用1个",
      "examples": [
        {
          "before": "这个工具真的绝绝子，谁懂啊家人们，直接闭眼入",
          "after": "这个工具我用了一周，三个最耗时的环节全部自动化了"
        }
      ]
    },
    {
      "id": "C11",
      "name": "二元对立框架",
      "category": "AI句式",
      "severity": "medium",
      "patterns": [
        "要么.{1,15}要么",
        "不是.{1,10}就是.{1,10}",
        "与其说是.{1,15}不如说是",
        "宁.{1,10}不.{1,10}",
        "只有.{1,15}才能.{1,15}",
        "如果.{1,15}那么.{1,15}否则",
        "一边是.{1,15}一边是",
        "X.{0,3}，而不是.{0,3}Y",
        "重点不是.{1,15}而是"
      ],
      "suggestion": "非黑即白的二元框架=AI简化现实的套路。承认中间地带，或者直接给第三种选择",
      "examples": [
        {
          "before": "企业要么全面拥抱AI，要么被时代淘汰",
          "after": "不拥抱AI的企业不会立刻死，但会用AI的同行会越跑越快"
        }
      ]
    },
    {
      "id": "C12",
      "name": "AI式谦卑",
      "category": "身份泄露",
      "severity": "medium",
      "patterns": [
        "我可能无法",
        "我暂时无法",
        "我只能提供",
        "作为AI我只能",
        "很抱歉我",
        "抱歉，我",
        "不好意思，我",
        "我目前不能",
        "我目前无法",
        "受限于",
        "我的能力范围",
        "在我的能力范围内"
      ],
      "suggestion": "AI式谦卑=对话机器人残留。删掉'抱歉/我无法'，直接说能做什么",
      "examples": [
        {
          "before": "很抱歉，作为AI我只能提供一般性建议",
          "after": "这里只讲通用方法，具体参数你按项目调"
        }
      ]
    }
  ]
}
