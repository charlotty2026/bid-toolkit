{
  "meta": {
    "name": "小红书专项检测",
    "description": "小红书/种草笔记场景：老模板开场、emoji堆叠、夸张形容词、假分享真广告、信息块模板、收藏党结尾",
    "version": "1.0.0"
  },
  "rules": [
    {
      "id": "X01",
      "name": "老模板开场",
      "category": "模板痕迹",
      "severity": "high",
      "patterns": [
        "家人们谁懂啊",
        "家人们，谁懂",
        "姐妹们快冲",
        "姐妹们冲",
        "谁懂啊",
        "谁懂",
        "救命",
        "我真的会谢",
        "我真的栓Q",
        "疯狂心动",
        "疯狂安利",
        "按头安利",
        "给我冲",
        "闭眼入",
        "无脑冲"
      ],
      "suggestion": "老模板开场=小红书AI批量生产的标志。改具体场景开头：'上周用了三天，来交作业'",
      "examples": [
        {
          "before": "家人们谁懂啊，这个工具我真的会谢，姐妹们快冲！",
          "after": "用了三天这个排版工具，把上周拖到周日的活提前两天交掉了"
        }
      ]
    },
    {
      "id": "X02",
      "name": "emoji堆叠",
      "category": "排版模板",
      "severity": "low",
      "patterns": [
        "(😍|🥰|🤩|🔥|💯|✨|🌟|💥|🎉|😭|🥹|😱|🤯|👍|👌|🙌|💪|❤️|🧡|💛|💚|💙|💜|🖤|💖|💗|💓|💕|💘|💝|🫶){3,}",
        "(哈哈哈哈){2,}",
        "(啊啊啊){2,}"
      ],
      "suggestion": "连续3个以上emoji/重复语气词=AI凑情绪。留1个，其余删掉",
      "examples": [
        {
          "before": "真的太好用了！！！😍😍😍🔥🔥🔥 谁用谁知道！！！",
          "after": "真的好用。上周用它把3小时的活压到40分钟。"
        }
      ]
    },
    {
      "id": "X03",
      "name": "夸张形容词",
      "category": "空洞词汇",
      "severity": "medium",
      "patterns": [
        "绝绝子",
        "yyds",
        "YYDS",
        "天花板级别",
        "封神了",
        "直接封神",
        "神仙(工具|软件|app)",
        "宝藏(工具|软件|app|店铺)",
        "神器",
        "巨好用",
        "超级好用",
        "无敌好用",
        "好用到哭",
        "好用到炸",
        "惊艳到",
        "美到窒息",
        "香到爆炸"
      ],
      "suggestion": "夸张形容词=情绪造假。评不了价才用'绝绝子'，真有用会写具体效果",
      "examples": [
        {
          "before": "这个神器绝绝子，好用到哭！",
          "after": "导出100页标书只要90秒，之前手动排要一下午"
        }
      ]
    },
    {
      "id": "X04",
      "name": "假分享真广告",
      "category": "结构套话",
      "severity": "high",
      "patterns": [
        "不好吃回来打我",
        "不好用回来找我",
        "不好用算我输",
        "用了都说好",
        "人手必备",
        "人手一个",
        "必备神器",
        "必备好物",
        "闭眼入不亏",
        "入手不亏",
        "买了不后悔",
        "后悔没早买",
        "相见恨晚",
        "早买早享受"
      ],
      "suggestion": "假分享真广告=AI带货腔。删掉'闭眼入/人手必备'，改成真实使用场景和代价",
      "examples": [
        {
          "before": "这款软件人手必备，闭眼入不亏，买了不后悔！",
          "after": "软件免费版够用，进阶版69/月，我是重度用户才开的"
        }
      ]
    },
    {
      "id": "X05",
      "name": "信息块模板",
      "category": "排版模板",
      "severity": "medium",
      "patterns": [
        "✅.{0,20}(必|建议|记得|记得要|一定要)",
        "📍.{0,20}(地址|位置|坐标|门店)",
        "⏰.{0,20}(时间|营业|几点|开放)",
        "🌟.{0,20}(推荐|必看|亮点|加分)",
        "💡.{0,20}(小贴士|提示|技巧|建议)",
        "💰.{0,20}(价格|费用|人均|花销)",
        "📌.{0,20}(笔记|收藏|重点)",
        "❗.{0,20}(注意|警告|避雷|千万别)"
      ],
      "suggestion": "emoji信息块=小红书AI模板，超过2块就是批量生产。改自然段落描述",
      "examples": [
        {
          "before": "✅ 必看：免费\n📍 位置：官网\n⏰ 时间：5分钟",
          "after": "免费，官网直接下，第一次用5分钟就上手了"
        }
      ]
    },
    {
      "id": "X06",
      "name": "收藏党结尾",
      "category": "结构套话",
      "severity": "low",
      "patterns": [
        "先码后看",
        "码住",
        "收藏慢慢看",
        "先收藏",
        "建议收藏",
        "存起来",
        "以后用得上",
        "早晚用得上",
        "先赞后看",
        "点赞收藏"
      ],
      "suggestion": "收藏党结尾=AI默认读者只看不学。真有用的内容读者自己会存",
      "examples": [
        {
          "before": "干货满满，建议先码后看，收藏慢慢学习",
          "after": "清单就10项，打印出来贴工位上，投标前过一遍"
        }
      ]
    }
  ]
}
